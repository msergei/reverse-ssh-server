# Public SSH port for tunnel clients (forward it on the router to this host)
SSH_PORT=34051

# LAN address + port where the tunnelled service is published (LAN only!)
LAN_BIND=192.168.10.53
LAN_PORT=13000

# Client public keys (ssh-ed25519 only), comma-separated
AUTHORIZED_KEYS=ssh-ed25519 AAAA... pi4-tunnel
