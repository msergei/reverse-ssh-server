# Tunnel server
SERVER_HOST=example.sn.mynetname.net
SERVER_PORT=34051
# Server host key, printed by the server on start: "ssh-ed25519 AAAA..."
SERVER_HOST_KEY=ssh-ed25519 AAAA...

# Client private key, base64 in one line:
#   ssh-keygen -t ed25519 -N "" -C pi4-tunnel -f tunnel_key && base64 < tunnel_key | tr -d '\n'
# (public part tunnel_key.pub goes to server AUTHORIZED_KEYS)
SSH_PRIVATE_KEY_B64=

# Service to publish on the server's LAN port: a compose service name (browser),
# or host.docker.internal for a service of this machine (it must listen on
# 0.0.0.0 or the docker bridge, not 127.0.0.1)
TARGET_HOST=browser
TARGET_PORT=3001
# http: any HTTP(S) answer counts as alive; tcp: port accepts connections
CHECK_MODE=http
CHECK_SCHEME=https

# Remote browser (docker-compose.browser.yml), comment out to run the tunnel only
# (then also change TARGET_HOST/TARGET_PORT)
COMPOSE_FILE=docker-compose.yml:docker-compose.browser.yml
# Raspberry Pi 4: hardware H.264 encoder
#COMPOSE_FILE=docker-compose.yml:docker-compose.browser.yml:docker-compose.browser-rpi.yml
BROWSER_USER=jr
BROWSER_PASSWORD=
# Stream: CSS scaling (no HiDPI) and FPS cap keep a Pi usable
#BROWSER_CSS_SCALING=true|locked
#BROWSER_FRAMERATE=20,8-20
